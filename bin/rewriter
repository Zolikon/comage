#!/bin/sh
# ReWriter CLI launcher. Claude Code puts a plugin's bin/ on the Bash tool's PATH; the installer
# symlinks this file into a bin dir, so resolve symlinks before locating rewriter.mjs.
self="$0"
while [ -h "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
exec node "$(cd "$(dirname "$self")/.." && pwd)/rewriter.mjs" "$@"
